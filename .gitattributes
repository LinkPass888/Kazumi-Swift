# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.storyboard text eol=lf
*.xcstrings text eol=lf
*.glsl text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Source code files (C/C++/Objective-C/Swift)
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.m text eol=lf
*.mm text eol=lf
*.swift text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.eot binary
*.woff binary
*.woff2 binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
*.a binary
*.ipa binary
*.dmg binary
*.zip binary
*.tar binary
*.gz binary
